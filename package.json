{
  "name": "pi-reasoning-tool",
  "version": "0.1.0",
  "description": "Pi extension: a single-parameter deep_reasoning tool whose tool-call argument carries model reasoning, plus /reasoning-tool to adjust the tool description",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "reasoning",
    "tool-call"
  ],
  "license": "MIT",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\""
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^24.0.0",
    "typebox": "1.3.27",
    "typescript": "~5.9.3"
  }
}
